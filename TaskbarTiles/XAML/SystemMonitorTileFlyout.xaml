<!-- 
    System Monitor Taskbar Tile — WinUI 3 XAML
    Flyout showing CPU/RAM/GPU ring gauges and top process list.
    Uses standard WinUI 3 controls and Fluent Design tokens.
-->
<UserControl
    x:Class="TaskbarTiles.SystemMonitorTileFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="380">

    <UserControl.Resources>
        <!-- Resource accent colors -->
        <Color x:Key="CpuColor">#60CDFF</Color>
        <Color x:Key="RamColor">#C78DFF</Color>
        <Color x:Key="GpuColor">#6CCB5F</Color>

        <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}"/>
        <SolidColorBrush x:Key="RamBrush" Color="{StaticResource RamColor}"/>
        <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}"/>
        <SolidColorBrush x:Key="CpuBgBrush" Color="#1A60CDFF"/>
        <SolidColorBrush x:Key="RamBgBrush" Color="#1AC78DFF"/>
        <SolidColorBrush x:Key="GpuBgBrush" Color="#1A6CCB5F"/>
    </UserControl.Resources>

    <!-- Main flyout surface -->
    <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <StackPanel>

            <!-- ═══ HEADER ═══ -->
            <Grid Padding="16,16,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="4"
                        Background="{StaticResource CpuBgBrush}"
                        Margin="0,0,12,0">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7F4;"
                              FontSize="16"
                              Foreground="{StaticResource CpuBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="System Monitor"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Windows 11 · AMD Ryzen 9 7950X"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Uptime badge -->
                <Border Grid.Column="2"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        CornerRadius="99"
                        Padding="8,2"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                        <Run Text="⬆"/>
                        <Run Text=" 4d 7h"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- ═══ RESOURCE GAUGES ═══ -->
            <TextBlock Text="RESOURCE USAGE"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       CharacterSpacing="50"
                       Margin="16,0,16,8"/>

            <Grid Margin="16,0,16,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Gauge -->
                <Border Grid.Column="0"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="56" Height="56">
                            <!-- Ring background -->
                            <ProgressRing Width="56" Height="56"
                                          IsIndeterminate="False"
                                          Value="65"
                                          Maximum="100"
                                          Foreground="{StaticResource CpuBrush}"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                            <!-- Percentage label -->
                            <TextBlock Text="65%"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="CPU"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="4.8 GHz · 12C"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- RAM Gauge -->
                <Border Grid.Column="1"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="56" Height="56">
                            <ProgressRing Width="56" Height="56"
                                          IsIndeterminate="False"
                                          Value="78"
                                          Maximum="100"
                                          Foreground="{StaticResource RamBrush}"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                            <TextBlock Text="78%"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="RAM"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="25 / 32 GB"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- GPU Gauge -->
                <Border Grid.Column="2"
                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="56" Height="56">
                            <ProgressRing Width="56" Height="56"
                                          IsIndeterminate="False"
                                          Value="30"
                                          Maximum="100"
                                          Foreground="{StaticResource GpuBrush}"
                                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                            <TextBlock Text="30%"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="GPU"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="RTX 4080"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Margin="16,0"/>

            <!-- ═══ TOP PROCESSES ═══ -->
            <TextBlock Text="TOP PROCESSES"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       CharacterSpacing="50"
                       Margin="16,12,16,4"/>

            <!-- Column headers -->
            <Grid Padding="16,4,16,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="2" Text="CPU"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right"
                           CharacterSpacing="50"/>
                <TextBlock Grid.Column="3" Text="RAM"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right"
                           CharacterSpacing="50"/>
            </Grid>

            <!-- Process: devenv.exe -->
            <Grid Padding="12,6" ColumnSpacing="10"
                  Margin="4,0" CornerRadius="4"
                  Background="Transparent"
                  PointerEntered="ProcessItem_PointerEntered"
                  PointerExited="ProcessItem_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="VS" FontSize="8" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="devenv.exe" FontSize="13"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="Visual Studio 2022"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="24.3%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="4.1 GB"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Process: msedge.exe -->
            <Grid Padding="12,6" ColumnSpacing="10" Margin="4,0" CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE774;" FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="msedge.exe" FontSize="13"/>
                    <TextBlock Text="Microsoft Edge — 34 tabs"
                               Style="{StaticResource CaptionTextBlockStyle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="12.8%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="3.6 GB"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Process: vmmem (WSL) -->
            <Grid Padding="12,6" ColumnSpacing="10" Margin="4,0" CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="🐳" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="vmmem" FontSize="13"/>
                    <TextBlock Text="WSL2 / Docker"
                               Style="{StaticResource CaptionTextBlockStyle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="9.4%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="6.2 GB"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Process: node.exe -->
            <Grid Padding="12,6" ColumnSpacing="10" Margin="4,0" CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="TS" FontSize="8" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="node.exe" FontSize="13"/>
                    <TextBlock Text="TypeScript Language Server"
                               Style="{StaticResource CaptionTextBlockStyle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="8.1%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="1.8 GB"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Process: copilot-agent.exe -->
            <Grid Padding="12,6,12,8" ColumnSpacing="10" Margin="4,0" CornerRadius="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <Border Width="20" Height="20" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="🤖" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="copilot-agent.exe" FontSize="13"/>
                    <TextBlock Text="GitHub Copilot"
                               Style="{StaticResource CaptionTextBlockStyle}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="5.2%"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CpuBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="920 MB"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource RamBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Margin="16,0"/>

            <!-- ═══ ACTION BUTTONS ═══ -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Padding="16,12,16,16">
                <Button Content="Task Manager"
                        Style="{StaticResource DefaultButtonStyle}"
                        MinWidth="0" Width="112"/>
                <Button Content="Resource Monitor"
                        Style="{StaticResource DefaultButtonStyle}"
                        MinWidth="0" Width="120"/>
                <Button Content="Details"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="0" Width="96"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
